{
  "workflow": {
    "apiVersion": "utos.io/v1",
    "kind": "Workflow",
    "metadata": { "name": "waiter", "version": "1.0.0" },
    "spec": {
      "activities": {
        "short": {
          "timer": { "duration": "90s" },
          "onSuccess": [ { "transition": { "name": "compound" } } ]
        },
        "compound": {
          "timer": { "duration": "2d12h30m" },
          "onSuccess": [ { "transition": { "name": "legacy" } } ]
        },
        "legacy": {
          "timer": { "duration": "86400s" },
          "onSuccess": [ { "transition": { "name": "templated" } } ]
        },
        "templated": {
          "timer": { "duration": "{{ input.retryAfter ?? '30s' }}" },
          "onSuccess": [ { "result": {} } ]
        }
      }
    }
  }
}
