{
  "workflow": {
    "apiVersion": "utos.io/v1",
    "kind": "Workflow",
    "metadata": { "name": "archive", "version": "1.0.0" },
    "spec": {
      "output": {
        "type": "object",
        "required": ["receipt"],
        "properties": {
          "receipt": { "$ref": "utos:file" }
        },
        "unevaluatedProperties": false
      },
      "activities": {
        "store": {
          "schema": {
            "input": {
              "type": "object",
              "required": ["contract", "photo"],
              "properties": {
                "photo": { "$ref": "utos:blob", "mediaType": "image/*", "maxSize": 10485760 },
                "contract": { "$ref": "utos:file", "mediaType": ["application/pdf", "image/tiff"], "maxSize": 1500 },
                "thumbnail": { "anyOf": [ { "$ref": "utos:blob", "maxSize": 2048 }, { "type": "null" } ] }
              },
              "unevaluatedProperties": false
            }
          },
          "http": { "method": "PUT", "url": "https://storage.example.com/archive", "body": "{{ input.photo }}" }
        }
      }
    }
  }
}
