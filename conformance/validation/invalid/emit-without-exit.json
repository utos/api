{
  "entryPoint": "greet:1.0.0",
  "workflows": {
    "greet:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "greet",
        "version": "1.0.0",
        "description": "An emit effect and no exit, in a list whose rules end the activity: the run would be stranded."
      },
      "spec": {
        "activities": {
          "produce": {
            "http": {
              "method": "GET",
              "url": "https://api.example.com/items"
            },
            "onSuccess": [
              {
                "emit": {
                  "items": "{{ output.items }}"
                }
              }
            ]
          }
        }
      }
    }
  }
}
