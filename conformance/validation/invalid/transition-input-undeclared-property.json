{
  "entryPoint": "acme/resize:1.0.0",
  "workflows": {
    "acme/resize:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "resize",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "The other half of the same rule: a closed target cannot be handed a property it does not declare, and a typo is how that happens."
      },
      "spec": {
        "activities": {
          "fetch": {
            "timer": {
              "duration": "1s"
            },
            "onSuccess": [
              {
                "transition": {
                  "name": "report",
                  "input": {
                    "megabytes": "{{ output.bytes }}"
                  }
                }
              }
            ]
          },
          "report": {
            "schema": {
              "input": {
                "type": "object",
                "properties": {
                  "bytes": {
                    "type": "integer"
                  }
                },
                "unevaluatedProperties": false
              }
            },
            "timer": {
              "duration": "1s"
            }
          }
        }
      }
    }
  }
}
