{
  "entryPoint": "acme/resize:1.0.0",
  "workflows": {
    "acme/resize:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "resize",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "Every declared value is an object with named keys, at the top of every slot. Not an array, not a scalar."
      },
      "spec": {
        "activities": {
          "resize": {
            "schema": {
              "input": {
                "type": "string"
              }
            },
            "timer": {
              "duration": "1s"
            }
          }
        }
      }
    }
  }
}
