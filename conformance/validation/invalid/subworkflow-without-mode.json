{
  "entryPoint": "acme/orchestrator:1.0.0",
  "workflows": {
    "acme/orchestrator:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "orchestrator",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "Sub-workflow activity with neither call nor spawn set."
      },
      "spec": {
        "activities": {
          "notify": {
            "workflow": {
              "workflow": "acme/send-email:2.1.0",
              "startActivity": "send"
            }
          }
        }
      }
    },
    "acme/send-email:2.1.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "send-email",
        "namespace": "acme",
        "version": "2.1.0"
      },
      "spec": {
        "activities": {
          "send": {
            "http": {
              "method": "POST",
              "url": "https://mail.example.com/send"
            }
          }
        }
      }
    }
  }
}
