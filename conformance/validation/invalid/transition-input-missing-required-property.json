{
  "entryPoint": "acme/resize:1.0.0",
  "workflows": {
    "acme/resize:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "resize",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "A transition transform that omits a property the target requires. The key set is literal, so this is certain at load however the values are rendered."
      },
      "spec": {
        "activities": {
          "fetch": {
            "timer": {
              "duration": "1s"
            },
            "onSuccess": [
              {
                "transition": {
                  "name": "report",
                  "input": {
                    "note": "{{ output.note }}"
                  }
                }
              }
            ]
          },
          "report": {
            "schema": {
              "input": {
                "type": "object",
                "required": [
                  "bytes"
                ],
                "properties": {
                  "bytes": {
                    "type": "integer"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "unevaluatedProperties": false
              }
            },
            "timer": {
              "duration": "1s"
            }
          }
        }
      }
    }
  }
}
