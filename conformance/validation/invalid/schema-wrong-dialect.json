{
  "entryPoint": "acme/resize:1.0.0",
  "workflows": {
    "acme/resize:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "resize",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "A bundle written by hand can carry a dialect this spec does not define; a compiler drops $schema entirely."
      },
      "spec": {
        "activities": {
          "resize": {
            "schema": {
              "input": {
                "$schema": "https://json-schema.org/draft-07/schema#",
                "type": "object",
                "properties": {
                  "photo": {
                    "type": "string"
                  }
                },
                "unevaluatedProperties": false
              }
            },
            "timer": {
              "duration": "1s"
            }
          }
        }
      }
    }
  }
}
