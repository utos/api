{
  "entryPoint": "greet:1.0.0",
  "workflows": {
    "greet:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": { "name": "greet", "version": "1.0.0", "description": "An empty error on onSuccess, where there is no failure to re-raise." },
      "spec": {
        "activities": {
          "say-hello": {
            "http": { "method": "GET", "url": "https://api.example.com/hello" },
            "onSuccess": [ { "error": {} } ]
          }
        }
      }
    }
  }
}
