{
  "entryPoint": "greet:1.0.0",
  "workflows": {
    "greet:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "greet",
        "version": "1.0.0",
        "description": "A promise branch that does not say which document it dispatches."
      },
      "spec": {
        "activities": {
          "fan-out": {
            "promise": {
              "all": {},
              "branches": [
                {
                  "name": "first",
                  "startActivity": "leg"
                }
              ]
            }
          },
          "leg": {
            "http": {
              "method": "GET",
              "url": "https://api.example.com/leg"
            }
          }
        }
      }
    }
  }
}
