{
  "entryPoint": "acme/resize:1.0.0",
  "workflows": {
    "acme/resize:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "resize",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "ScheduleExecutionRequest.env is map<string, string>, so a declared variable of any other type describes a run that cannot exist."
      },
      "spec": {
        "env": {
          "type": "object",
          "required": [
            "PORT"
          ],
          "properties": {
            "PORT": {
              "type": "integer"
            }
          }
        },
        "activities": {
          "resize": {
            "timer": {
              "duration": "1s"
            }
          }
        }
      }
    }
  }
}
