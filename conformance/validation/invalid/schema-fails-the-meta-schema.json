{
  "entryPoint": "acme/resize:1.0.0",
  "workflows": {
    "acme/resize:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "resize",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "minLength takes a non-negative integer. A string there is not a stricter rule, it is not a rule."
      },
      "spec": {
        "activities": {
          "resize": {
            "schema": {
              "input": {
                "type": "object",
                "properties": {
                  "photo": {
                    "type": "string",
                    "minLength": "3"
                  }
                },
                "unevaluatedProperties": false
              }
            },
            "timer": {
              "duration": "1s"
            }
          }
        }
      }
    }
  }
}
