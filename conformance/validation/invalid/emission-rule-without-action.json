{
  "entryPoint": "acme/watcher:1.0.0",
  "workflows": {
    "acme/watcher:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "watcher",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "An onEmitted rule that matches a value and then does nothing with it."
      },
      "spec": {
        "activities": {
          "watch": {
            "workflow": {
              "workflow": "acme/mailbox:1.0.0",
              "startActivity": "poll",
              "call": {
                "onEmitted": [
                  {
                    "condition": "{{ output.urgent }}"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "acme/mailbox:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "mailbox",
        "namespace": "acme",
        "version": "1.0.0"
      },
      "spec": {
        "activities": {
          "poll": {
            "http": {
              "method": "GET",
              "url": "https://api.example.com/messages"
            }
          }
        }
      }
    }
  }
}
