{
  "entryPoint": "greet:1.0.0",
  "workflows": {
    "greet:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": { "name": "greet", "version": "1.0.0" },
      "spec": {
        "activities": {
          "say-hello": {
            "http": { "method": "GET", "url": "https://api.example.com/hello" },
            "onSuccess": [ { "condition": "let n = 0; while (false) { n = 1 } n === 0", "transition": { "name": "end" } } ]
          }
        }
      }
    }
  }
}
