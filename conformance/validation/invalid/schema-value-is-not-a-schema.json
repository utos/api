{
  "entryPoint": "acme/resize:1.0.0",
  "workflows": {
    "acme/resize:1.0.0": {
      "apiVersion": "utos.io/v1",
      "kind": "Workflow",
      "metadata": {
        "name": "resize",
        "namespace": "acme",
        "version": "1.0.0",
        "description": "A Struct will carry a string where a schema belongs, and nothing else would object to it."
      },
      "spec": {
        "activities": {
          "resize": {
            "schema": {
              "input": {
                "type": "object",
                "properties": {
                  "photo": "string"
                },
                "unevaluatedProperties": false
              }
            },
            "timer": {
              "duration": "1s"
            }
          }
        }
      }
    }
  }
}
